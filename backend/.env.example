PORT=4400
# Origin of the Next.js app (used for CORS and payment callbacks)
CLIENT_ORIGIN=http://localhost:3400
# Signs login sessions. Required in production: a long random value, e.g. from `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Donations: leave empty to use the built-in mock checkout. Set to a Paystack secret key to take real gifts.
PAYSTACK_SECRET_KEY=
# Cover images: leave R2_ACCOUNT_ID empty to save covers to backend/uploads/. Set all five to use Cloudflare R2.
R2_ACCOUNT_ID= 334d97051cf7332bc26e8715d7d576e1
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket (custom domain or r2.dev address), no trailing slash
R2_PUBLIC_URL=
# PostgreSQL. Matches the database in ../docker-compose.yml (start it with: npm run db:up)
DATABASE_URL=postgresql://agumagu:agumagu@localhost:5544/agumagu
# Direct (non-pooled) connection for Prisma migrations. On Neon, `neon env pull` fills both; locally leave it empty.
DATABASE_URL_UNPOOLED=
# Outgoing email for password resets. Leave SMTP_HOST empty in development: reset links are printed in this console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ọbaifo <no-reply@obaifo.example>"
